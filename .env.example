# ==============================================================================
# AIOS WorkLens - Tệp Mẫu Cấu Hình Môi Trường (.env.example)
#
# Nguồn sự thật: Kiểm chứng trực tiếp tại máy nhà (H410ASROCK) và mã nguồn
# (src/aios_habit/ai_lane.py, src/aios_habit/ai_provider_bridge.py,
#  src/aios_habit/workspace_chat_app.py, RUN_AIOS_WORKSPACE_CHAT.bat).
#
# QUY TẮC BẢO MẬT: TUYỆT ĐỐI không commit tệp .env thật hoặc giá trị khóa API lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH TUYẾN TRẢ LỜI AI CHO MÁY NHÀ (Home Machine - H410ASROCK)
# ------------------------------------------------------------------------------

# Ghi đè tuyến trả lời mặc định:
# - nakazasen_router: Tuyến Command Code router (mặc định ưu tiên khi ghim)
# - gemini_web: Tuyến Gemini qua cầu nối Antigravity (tự động bật qua RUN_AIOS_WORKSPACE_CHAT.bat)
# - cagent_api: Tuyến C-Agent (chỉ dành cho máy công ty, máy nhà không kết nối được)
# - local: Chạy cục bộ hoàn toàn, không gọi AI ngoài
# Nguồn: src/aios_habit/ai_lane.py (MANUAL_OVERRIDE_ENV)
AIOS_AI_BACKEND=nakazasen_router

# Họ biến cấu hình tuyến Command Code (OpenAI-compatible endpoint):
# Nguồn: src/aios_habit/ai_provider_bridge.py, src/aios_habit/workspace_chat_app.py
AIOS_LOCAL_AI_ENDPOINT=https://api.commandcode.ai/provider/v1/chat/completions

# Model chính (Tier 1 - pool miễn phí hiện hành trên Command Code):
AIOS_LOCAL_AI_MODEL=reflection/beam:free

# Danh sách model dự phòng (Tier 2/3 - cách nhau bằng dấu phẩy):
AIOS_LOCAL_AI_FAILOVER_MODELS=poolside/laguna-s-2.1-free,stealth/glyph-cluster:free

# Khóa API cho Command Code (điền khóa của bạn, không để lộ):
AIOS_LOCAL_AI_API_KEY=your_command_code_api_key_here

# Vùng chạy tuyến và thời gian chờ (giây):
AIOS_LOCAL_AI_LOCALITY=cloud
AIOS_LOCAL_AI_TIMEOUT_SECONDS=90
AIOS_SYNTHESIS_ALLOW_CLOUD_PROVIDERS=1

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH BỘ CHỈ MỤC & TRUY HỒI RAG V2 (MÁY NHÀ)
# ------------------------------------------------------------------------------
# Đường dẫn lưu trữ thư viện RAG v2 production trên ổ D:
AIOS_RAG_STORAGE_DIR=D:/AIOS_workspace_chat_rag_v2_production
AIOS_WORKSPACE_RAG_V2_CANARY_ENABLED=1
AIOS_WORKSPACE_RAG_V2_LOCAL_PILOT_ENABLED=1
AIOS_WORKSPACE_RAG_V2_PROFILE=bge_m3_hybrid
AIOS_RETRIEVAL_DEVICE=cpu
AIOS_WORKSPACE_RAG_V2_ADAPTIVE_ENABLED=1
AIOS_FEATURE_EXPERT_KNOWLEDGE_ACQUISITION=1

# Đường dẫn DB tra cứu lỗi đã hợp nhất (chuẩn 30.075 ca):
AIOS_ERROR_CASES_DB=C:\tmp\kdtps_standard\error_cases_reconciled.db

# Cờ tăng tốc và timeout cho môi trường CPU-only máy nhà:
AIOS_RAG_V2_NUMPY_DENSE=1
AIOS_BGE_QUERY_TIMEOUT=1200
AIOS_BGE_INIT_TIMEOUT=420
AIOS_RAGV2_WORKER_PERSIST=1
AIOS_FEATURE_CHAT_ACTION=1
AIOS_DOMAIN_ROUTING_ENABLED=1

# ------------------------------------------------------------------------------
# 3. CƠ CHẾ CẤU HÌNH CHO MÁY CÔNG TY (Company Machine - PC0575)
# (Chỉ mang tính tham chiếu cơ chế; cấu hình thực tế nằm tại .env của PC0575)
# ------------------------------------------------------------------------------
# Trên PC0575, launcher ghim tuyến C-Agent:
# AIOS_AI_BACKEND=cagent_api
# AIOS_CAGENT_API_URL=https://kdtvn-ai.cmcts.vn/api/v1/prediction/<chatflow_id>
# AIOS_CAGENT_AUTH_URL=https://kdtvn-ai.cmcts.vn
# AIOS_CAGENT_TIMEOUT_SECONDS=60
# AIOS_CAGENT_MAX_HISTORY_MESSAGES=6
# AIOS_CAGENT_MAX_HISTORY_CHARS=4000

# ------------------------------------------------------------------------------
# 4. DANH MỤC BIẾN ĐÃ LỖI THỜI / LỆCH CẤU HÌNH (DEPRECATED & DRIFT WARNING)
# ------------------------------------------------------------------------------
# CẢNH BÁO: Các biến dưới đây KHÔNG CÒN HIỆU LỰC trong mã nguồn runtime hiện hành:
#
# - AIOS_ANSWER_MODE: KHÔNG CÒN HIỆU LỰC.
#   Mã nguồn src/aios_habit/ai_lane.py chỉ đọc biến AIOS_AI_BACKEND.
#   Tuyệt đối không dùng AIOS_ANSWER_MODE=command_code.
#
# - AIOS_COMMAND_CODE_MODEL: KHÔNG CÒN HIỆU LỰC.
#   Tên model được đọc từ AIOS_LOCAL_AI_MODEL và AIOS_LOCAL_AI_FAILOVER_MODELS
#   trong src/aios_habit/ai_provider_bridge.py và workspace_chat_app.py.
#
# - COMMANDCODE_API_KEY: KHÔNG CÒN HIỆU LỰC trong runtime AIOS WorkLens.
#   Khóa gọi tuyến Command Code được đọc từ biến AIOS_LOCAL_AI_API_KEY
#   trong src/aios_habit/ai_provider_bridge.py.
#
# - z-ai/glm-5.2: KHÔNG PHẢI MODEL MẶC ĐỊNH HIỆN HÀNH.
#   Model free pool hiện tại của Command Code gồm reflection/beam:free,
#   poolside/laguna-s-2.1-free và stealth/glyph-cluster:free.
